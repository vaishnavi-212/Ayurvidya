# Copy to .env and fill in. NEVER commit .env and never paste keys in a chat.

# --- step generation (Gemini) ---
AYV_LLM=openai:gemini-3.5-flash-lite
AYV_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=
# same Gemini key, used for gemini-embedding-001 when AYV_EMBEDDER=gemini:...
GEMINI_API_KEY=

# --- chatbot (Llama on Groq: free key at console.groq.com) ---
AYV_CHAT_LLM=openai:llama-3.1-8b-instant
AYV_CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
AYV_CHAT_API_KEY_ENV=GROQ_API_KEY
GROQ_API_KEY=

# --- chatbot offline with Ollama instead (no key) ---
# AYV_CHAT_LLM=openai:llama3.2:3b
# AYV_CHAT_LLM_BASE_URL=http://localhost:11434/v1

# --- student notes (Excel upload) ---
AYV_CLASS_CODE=
AYV_NOTES_SECRET=
# online: a free Postgres URL (Supabase / Neon). Empty = local SQLite file.
DATABASE_URL=

ADMIN_TOKEN=change-me