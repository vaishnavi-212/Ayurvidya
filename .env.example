# Copy to .env and fill in. NEVER commit .env and never paste keys in a chat.

# --- step generation (Gemini) ---
AYV_LLM=openai:gemini-3.5-flash-lite
AYV_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=

# --- retrieval: Gemini embeddings in ChromaDB (same key as OPENAI_API_KEY) ---
AYV_EMBEDDER=gemini:gemini-embedding-001
AYV_VECTOR_STORE=chroma
GEMINI_API_KEY=

# --- chatbot online: Gemini with its own key (second Google project) ---
AYV_CHAT_LLM=openai:gemini-3.5-flash-lite
AYV_CHAT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AYV_CHAT_API_KEY_ENV=GEMINI_CHAT_KEY
GEMINI_CHAT_KEY=

# --- chatbot offline: Llama 3.2 on Ollama (put # on the 3 chat lines above, remove # here) ---
# AYV_CHAT_LLM=openai:ayurvidya-llama
# AYV_CHAT_LLM_BASE_URL=http://localhost:11434/v1

# --- database for student notes + scholar facts (Supabase session pooler URI) ---
DATABASE_URL=
AYV_CLASS_CODE=
AYV_NOTES_SECRET=
AYV_SCHOLAR_TOKEN=

ADMIN_TOKEN=change-me